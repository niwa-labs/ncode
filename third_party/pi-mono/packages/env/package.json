{
	"name": "@earendil-works/pi-env",
	"version": "1.6.0",
	"description": "Remote execution environments for Pi Durable: a small daemon deployed over SSH and its ExecutionEnv client",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"bin",
		"docs",
		"README.md",
		"CHANGELOG.md"
	],
	"keywords": [
		"durable-execution",
		"agents",
		"ssh",
		"remote"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/env"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/chord": "workspace:*",
		"@earendil-works/pi-durable": "workspace:*"
	},
	"devDependencies": {
		"vitest": "4.1.12"
	}
}
