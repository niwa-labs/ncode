{
	"name": "@earendil-works/pi-ai",
	"version": "1.6.0",
	"description": "Unified LLM API with automatic model discovery and provider configuration",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./dist/compat.js",
		"./dist/images.js",
		"./dist/providers/images/register-builtins.js",
		"./src/compat.ts",
		"./src/images.ts",
		"./src/providers/images/register-builtins.ts"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./models": {
			"source": "./src/models.ts",
			"types": "./dist/models.d.ts",
			"import": "./dist/models.js"
		},
		"./session-resources": {
			"source": "./src/session-resources.ts",
			"types": "./dist/session-resources.d.ts",
			"import": "./dist/session-resources.js"
		},
		"./compat": {
			"source": "./src/compat.ts",
			"types": "./dist/compat.d.ts",
			"import": "./dist/compat.js"
		},
		"./providers/*": {
			"source": "./src/providers/*.ts",
			"types": "./dist/providers/*.d.ts",
			"import": "./dist/providers/*.js"
		},
		"./api/*": {
			"source": "./src/api/*.ts",
			"types": "./dist/api/*.d.ts",
			"import": "./dist/api/*.js"
		},
		"./utils/*": {
			"source": "./src/utils/*.ts",
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.js"
		},
		"./oauth": {
			"source": "./src/oauth.ts",
			"types": "./dist/oauth.d.ts",
			"import": "./dist/oauth.js"
		},
		"./bedrock-provider": {
			"source": "./src/bedrock-provider.ts",
			"types": "./dist/bedrock-provider.d.ts",
			"import": "./dist/bedrock-provider.js"
		},
		"./bun-oauth": {
			"source": "./src/bun-oauth.ts",
			"types": "./dist/bun-oauth.d.ts",
			"import": "./dist/bun-oauth.js"
		},
		"./lazy-bedrock-provider": {
			"source": "./src/lazy-bedrock-provider.ts",
			"types": "./dist/lazy-bedrock-provider.d.ts",
			"import": "./dist/lazy-bedrock-provider.js"
		},
		"./lazy-oauth": {
			"source": "./src/lazy-oauth.ts",
			"types": "./dist/lazy-oauth.d.ts",
			"import": "./dist/lazy-oauth.js"
		}
	},
	"bin": {
		"pi-ai": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"dependencies": {
		"@anthropic-ai/sdk": "0.129.0",
		"@aws-sdk/client-bedrock-runtime": "3.1127.0",
		"@aws-sdk/credential-provider-node": "3.972.82",
		"@earendil-works/pi-schema": "workspace:*",
		"@earendil-works/pi-telemetry": "workspace:*",
		"@google/genai": "2.32.0",
		"@smithy/node-http-handler": "4.12.1",
		"http-proxy-agent": "9.1.0",
		"https-proxy-agent": "9.1.0",
		"openai": "7.59.0",
		"partial-json": "0.1.7"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"anthropic",
		"gemini",
		"bedrock",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/ai"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"canvas": "3.2.3",
		"typebox": "1.3.27",
		"vitest": "4.1.12"
	}
}
