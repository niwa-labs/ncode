{
	"name": "@earendil-works/pi-coding-agent",
	"version": "1.6.0",
	"description": "Coding agent CLI with read, bash, edit, write tools and session management",
	"type": "module",
	"piConfig": {
		"configDir": ".pi"
	},
	"bin": {
		"pi": "dist/bundle/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rpc-entry": {
			"import": "./dist/bundle/rpc-entry.js"
		},
		"./tools": {
			"source": "./src/core/tools/index.ts",
			"types": "./dist/core/tools/index.d.ts",
			"import": "./dist/core/tools/index.js"
		},
		"./auth-storage": {
			"source": "./src/core/auth-storage.ts",
			"types": "./dist/core/auth-storage.d.ts",
			"import": "./dist/core/auth-storage.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"examples",
		"schemas",
		"containerization.md",
		"CHANGELOG.md"
	],
	"dependencies": {
		"@earendil-works/pi-agent-core": "workspace:*",
		"@earendil-works/pi-ai": "workspace:*",
		"@earendil-works/pi-codemode": "workspace:*",
		"@earendil-works/pi-mcp": "workspace:*",
		"@earendil-works/pi-tui": "workspace:*",
		"@silvia-odwyer/photon-node": "0.3.4",
		"brace-expansion": "5.0.12",
		"chalk": "6.0.0",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.8",
		"jiti": "2.7.0",
		"lovely-mermaid": "0.3.3",
		"minimatch": "11.0.3",
		"proper-lockfile": "4.1.2",
		"quickjs-wasi": "3.6.2",
		"semver": "7.8.5",
		"typebox": "1.3.27",
		"undici": "8.12.4",
		"yaml": "2.9.0"
	},
	"overrides": {
		"protobufjs": "7.6.6"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/hosted-git-info": "3.0.5",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"marked": "18.0.11",
		"vitest": "4.1.12"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
