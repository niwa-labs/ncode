{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024"],
    "target": "ES2024",
    // The paths entries compile vendored pi/chord SOURCES (same resolution the
    // standalone typecheck derives); mirror the standalone overrides.
    "allowImportingTsExtensions": true,
    "noImplicitOverride": false,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@earendil-works/chord": ["../../third_party/chord/src/index.ts"],
      "@earendil-works/chord/context": ["../../third_party/chord/src/context/index.ts"],
      "@earendil-works/chord/delta": ["../../third_party/chord/src/delta/index.ts"],
      "@earendil-works/chord/output": ["../../third_party/chord/src/output.ts"],
      "@earendil-works/pi-durable": ["../../third_party/pi-durable/src/index.ts"],
      "@earendil-works/pi-durable/env": ["../../third_party/pi-durable/src/env/index.ts"],
      "@earendil-works/pi-durable/env/node": ["../../third_party/pi-durable/src/env/node.ts"],
      "@earendil-works/pi-env": ["../../third_party/pi-mono/packages/env/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
