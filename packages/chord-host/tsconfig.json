{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024"],
    "target": "ES2024",
    // The paths entries compile neighbor-package SOURCES (same resolution the
    // standalone typecheck derives); vendored chord sources are written under
    // the upstream flag set, so mirror the standalone overrides:
    "allowImportingTsExtensions": true,
    "noImplicitOverride": false,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@mavis/logging": ["../packages/logging/src/index.ts"],
      "@earendil-works/chord": ["../../third_party/chord/src/index.ts"],
      "@earendil-works/chord/context": ["../../third_party/chord/src/context/index.ts"],
      "@earendil-works/chord/delta": ["../../third_party/chord/src/delta/index.ts"],
      "@earendil-works/chord/telemetry-sqlite": ["../../third_party/chord/src/telemetry-sqlite/index.ts"],
      "@earendil-works/chord/sqlite": ["../../third_party/chord/src/sqlite/index.ts"],
      "@earendil-works/chord/sqlite/node": ["../../third_party/chord/src/sqlite/node.ts"],
      "@earendil-works/pi-telemetry": ["../../third_party/pi-mono/packages/telemetry/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
